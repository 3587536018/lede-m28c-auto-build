#!/bin/sh
# Keep the image root partition at 1 GiB. Reuse an existing ext4 /opt or an
# opt/optdata partition; otherwise use only verified trailing unallocated space.
# The Docker package installs an empty /opt/docker placeholder in the image.
# Never hide existing data, format an existing partition or copy Docker data
# automatically.
# A nonzero exit keeps this uci-defaults script available for the next boot.

set -u

fail() {
  echo "99-expand-data: $*" >&2
  return 1
}

canonical_device() {
  readlink -f "$1" 2>/dev/null
}

partition_disk() {
  local name path
  name=${1##*/}
  [ -f "/sys/class/block/$name/partition" ] || return 1
  path=$(readlink -f "/sys/class/block/$name") || return 1
  printf '/dev/%s\n' "$(basename "$(dirname "$path")")"
}

# mountinfo identifies the real device even when /rom is mounted as /dev/root
# and / is an overlay over a loop-backed squashfs root partition.
mounted_partition() {
  local info id fstype root name
  info=$(awk -v target="$1" '
    $5 == target {
      count++; id=$3; root=$4
      for (i=7; i<=NF; i++) if ($i == "-") { fs=$(i+1); break }
    }
    END { if (count == 1) print id, fs, root; else if (count > 1) print "ambiguous unknown unknown" }
  ' /proc/self/mountinfo) || return 1
  [ -n "$info" ] || return 1
  read -r id fstype root <<EOF
$info
EOF
  name=$(readlink -f "/sys/dev/block/$id" 2>/dev/null) || name=unknown
  printf '/dev/%s %s %s\n' "${name##*/}" "$fstype" "$root"
}

find_boot_partition() {
  local target info candidate token
  for target in /rom /; do
    info=$(mounted_partition "$target") || continue
    candidate=${info%% *}
    if partition_disk "$candidate" >/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  candidate=$(canonical_device /dev/root) || candidate=
  if [ -n "$candidate" ] && partition_disk "$candidate" >/dev/null; then
    printf '%s\n' "$candidate"
    return 0
  fi
  for token in $(cat /proc/cmdline); do
    case "$token" in
      root=/dev/*) candidate=$(canonical_device "${token#root=}") || candidate= ;;
      root=PARTUUID=*|root=UUID=*) candidate=$(blkid -t "${token#root=}" -o device 2>/dev/null) || candidate= ;;
      *) continue ;;
    esac
    if [ -n "$candidate" ] && partition_disk "$candidate" >/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

filesystem_type() {
  blkid -s TYPE -o value "$1" 2>/dev/null
}

find_labeled_partition() {
  local entry candidate label found=
  for entry in /sys/class/block/*; do
    [ -f "$entry/partition" ] || continue
    candidate="/dev/${entry##*/}"
    [ "$(partition_disk "$candidate")" = "$DISK" ] || continue
    label=$(blkid -s LABEL -o value "$candidate" 2>/dev/null) || label=
    case "$label" in
      opt|optdata)
        [ "$candidate" != "$BOOT_PARTITION" ] || return 1
        [ -z "$found" ] || return 1
        found=$candidate
        ;;
    esac
  done
  printf '%s\n' "$found"
}

# Output the next partition number, start/end logical sectors and sector size.
# Require a simple, contiguous partition table and at least 768 MiB after the
# last existing partition. Holes, extended partitions and unknown tables stop.
partition_plan() {
  local table
  table=$(parted -m -s "$DISK" unit s print free 2>/dev/null) || return 1
  printf '%s\n' "$table" | awk -F: '
    NR == 2 {
      sector=$4+0; table=$6
      if ((sector != 512 && sector != 4096) || (table != "msdos" && table != "gpt")) bad=1
    }
    $2 ~ /^[0-9]+s$/ && $3 ~ /^[0-9]+s$/ {
      start=$2+0; end=$3+0; kind=$5; sub(/;$/, "", kind)
      if (kind == "free") {
        if (end > free_end) { free_start=start; free_end=end }
      } else if ($1 ~ /^[0-9]+$/) {
        count++; if ($1+0 > number) number=$1+0
        if (end > last_end) last_end=end
        if (kind == "extended") bad=1
      } else bad=1
    }
    END {
      if (bad || !sector || !count || count != number || (table == "msdos" && number >= 4)) exit 1
      align=1048576/sector
      start=int((free_start+align-1)/align)*align
      if (free_start <= last_end || (free_end-start+1)*sector < 805306368) exit 1
      printf "%d %.0f %.0f %d\n", number+1, start, free_end, sector
    }
  '
}

create_data_partition() {
  local plan number start end sector part prefix tries actual_start actual_size signature
  command -v parted >/dev/null 2>&1 || { fail "parted is missing"; return 1; }
  plan=$(partition_plan) || { fail "cannot confirm sufficient trailing free space; existing partitions preserved"; return 1; }
  read -r number start end sector <<EOF
$plan
EOF
  case "$DISK" in *[0-9]) prefix="${DISK}p" ;; *) prefix=$DISK ;; esac
  part="${prefix}${number}"
  [ ! -e "$part" ] || { fail "$part already exists; refusing to format it"; return 1; }
  parted -s -a optimal "$DISK" unit s mkpart primary ext4 "${start}s" "${end}s" >&2 || {
    fail "partition creation failed; retry after inspecting the partition table"
    return 1
  }
  if command -v partprobe >/dev/null 2>&1; then partprobe "$DISK" >&2 || true; fi
  if command -v blockdev >/dev/null 2>&1; then blockdev --rereadpt "$DISK" >&2 || true; fi
  tries=0
  while [ ! -b "$part" ] && [ "$tries" -lt 5 ]; do
    sleep 1
    tries=$((tries + 1))
  done
  [ -b "$part" ] || { fail "$part is not available; existing partitions preserved"; return 1; }
  actual_start=$(cat "/sys/class/block/${part##*/}/start") || return 1
  actual_size=$(cat "/sys/class/block/${part##*/}/size") || return 1
  [ "$actual_start" -eq "$((start * sector / 512))" ] &&
    [ "$actual_size" -eq "$(((end - start + 1) * sector / 512))" ] || {
    fail "$part geometry differs from the new partition plan; refusing to format"
    return 1
  }
  signature=$(filesystem_type "$part") || signature=
  [ -z "$signature" ] || { fail "$part contains a filesystem signature; refusing to overwrite it"; return 1; }
  mkfs.ext4 -L optdata "$part" >&2 || { fail "format failed; inspect $part before retrying"; return 1; }
  printf '%s\n' "$part"
}

verify_opt_mount() {
  local info actual fstype root target system_mount
  info=$(mounted_partition /opt) || return 1
  read -r actual fstype root <<EOF
$info
EOF
  [ "$actual" = "$PART" ] && [ "$fstype" = ext4 ] && [ "$root" = / ] &&
    [ "$actual" != "$BOOT_PARTITION" ] && partition_disk "$actual" >/dev/null || return 1
  for target in / /rom /overlay; do
    system_mount=$(mounted_partition "$target") || continue
    [ "${system_mount%% *}" != "$actual" ] || return 1
  done
}

configure_storage() {
  local uuid
  verify_opt_mount || { fail "/opt is not the expected ext4 data partition"; return 1; }
  uuid=$(blkid -s UUID -o value "$PART" 2>/dev/null) || uuid=
  [ -n "$uuid" ] || { fail "$PART has no filesystem UUID"; return 1; }
  uci -q delete fstab.opt || true
  uci -q set fstab.opt=mount &&
    uci -q set "fstab.opt.uuid=$uuid" &&
    uci -q set fstab.opt.target=/opt &&
    uci -q set fstab.opt.fstype=ext4 &&
    uci -q set fstab.opt.enabled=1 &&
    uci -q commit fstab || { fail "saving /opt mount configuration failed"; return 1; }
  if uci -q get dockerd.globals >/dev/null 2>&1; then
    [ ! -L /opt/docker ] || { fail "/opt/docker is a symlink; inspect it manually"; return 1; }
    mkdir -p /opt/docker &&
      uci -q set dockerd.globals.data_root=/opt/docker &&
      uci -q commit dockerd || { fail "saving Docker storage configuration failed"; return 1; }
  fi
}

configure_swap() {
  local swapfile=/opt/swapfile available temporary
  verify_opt_mount || { fail "/opt is not mounted; refusing to create swap on rootfs"; return 1; }
  [ ! -L "$swapfile" ] || { fail "$swapfile is a symlink; refusing to use it"; return 1; }
  if [ -e "$swapfile" ]; then
    [ -f "$swapfile" ] && [ "$(filesystem_type "$swapfile")" = swap ] || {
      fail "$swapfile is not a recognized swap file; existing contents preserved"
      return 1
    }
  else
    available=$(df -Pk /opt | awk 'NR == 2 { print $4 }')
    case "$available" in ''|*[!0-9]*) fail "cannot determine /opt free space"; return 1 ;; esac
    [ "$available" -ge 655360 ] || { fail "/opt needs 640 MiB free to create 512 MiB swap"; return 1; }
    temporary=$(mktemp /opt/.m28c-swap.XXXXXX) || return 1
    if ! dd if=/dev/zero of="$temporary" bs=1M count=512 2>/dev/null ||
       ! chmod 600 "$temporary" || ! mkswap "$temporary" >/dev/null 2>&1; then
      rm -f "$temporary"
      fail "swap creation failed"
      return 1
    fi
    mv "$temporary" "$swapfile" || { rm -f "$temporary"; return 1; }
  fi
  chmod 600 "$swapfile" || return 1
  if ! awk -v file="$swapfile" '$1 == file { found=1 } END { exit !found }' /proc/swaps; then
    swapon "$swapfile" || { fail "activating swap failed"; return 1; }
  fi
  uci -q delete fstab.swap || true
  uci -q set fstab.swap=swap &&
    uci -q set "fstab.swap.device=$swapfile" &&
    uci -q set fstab.swap.enabled=1 &&
    uci -q commit fstab || { fail "saving swap configuration failed"; return 1; }
}

verify_unmounted_opt() {
  local entry child
  [ ! -L /opt ] || { fail "/opt is a symlink; inspect it manually"; return 1; }
  [ -e /opt ] || return 0
  [ -d /opt ] || { fail "/opt is not a directory; leaving it untouched"; return 1; }
  for entry in /opt/* /opt/.[!.]* /opt/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    # Only the empty directory shipped by the Docker package is safe to hide.
    # After Docker has started it may hold real data on the root overlay.
    [ "$entry" = /opt/docker ] && [ -d "$entry" ] && [ ! -L "$entry" ] || {
      fail "unmounted /opt contains data or unexpected entries; preserve them before retrying"
      return 1
    }
    ls -A "$entry" >/dev/null || { fail "cannot inspect $entry"; return 1; }
    for child in "$entry"/* "$entry"/.[!.]* "$entry"/..?*; do
      [ -e "$child" ] || [ -L "$child" ] || continue
      fail "$entry contains data; preserve it before retrying"
      return 1
    done
  done
}

main() {
  local info fstype root
  if info=$(mounted_partition /opt); then
    # An already mounted data filesystem can be reused on ext4 installations
    # without /rom or a resolvable root= argument. Discovery is only mandatory
    # when we need to choose or create a partition ourselves.
    BOOT_PARTITION=$(find_boot_partition) || BOOT_PARTITION=
    read -r PART fstype root <<EOF
$info
EOF
    verify_opt_mount || { fail "existing /opt is not a separate ext4 partition; leaving it untouched"; return 1; }
  else
    # Reject root-overlay data before changing any partition geometry.
    verify_unmounted_opt || return 1
    BOOT_PARTITION=$(find_boot_partition) || { fail "cannot identify the boot partition"; return 1; }
    DISK=$(partition_disk "$BOOT_PARTITION") || return 1
    [ -b "$DISK" ] || { fail "$DISK is not a block device"; return 1; }
    PART=$(find_labeled_partition) || { fail "ambiguous or unsafe opt/optdata labels; existing partitions preserved"; return 1; }
    if [ -z "$PART" ]; then
      PART=$(create_data_partition) || return 1
    fi
    [ "$(filesystem_type "$PART")" = ext4 ] || { fail "$PART is not ext4; refusing to format an existing partition"; return 1; }
    mkdir -p /opt || return 1
    verify_unmounted_opt || return 1
    mount -t ext4 "$PART" /opt || { fail "mounting $PART at /opt failed"; return 1; }
    verify_opt_mount || { fail "/opt mount verification failed"; return 1; }
  fi
  configure_storage && configure_swap || return 1
  echo "99-expand-data: verified $PART at /opt; Docker storage and swap configured"
}

main "$@"
