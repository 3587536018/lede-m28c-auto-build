#!/bin/sh
# 99-expand-data: 首次启动自动扩展存储（幂等，可重复执行）
# - ext4 rootfs   (方案2): rootfs 分区 resize2fs 扩展到磁盘 100%，系统原生吃满全盘
# - squashfs rootfs (方案3): 创建 p3 数据分区(占满剩余)挂载到 /opt/docker 给 docker
# 无论哪种，都自动配置 512MB swap

set -u

# 1. 找到启动磁盘
root_dev=""
if [ -L /dev/root ]; then
  root_dev=$(readlink -f /dev/root 2>/dev/null || echo "")
fi
case "$root_dev" in
  /dev/mmcblk*)
    disk=$(echo "$root_dev" | sed 's/p[0-9]*$//')
    ;;
  *)
    root_mnt=$(mount | awk '$3=="/rom" || $3=="/" {print $1; exit}')
    case "$root_mnt" in
      /dev/mmcblk*)
        disk=$(echo "$root_mnt" | sed 's/p[0-9]*$//')
        ;;
      *)
        disk=""
        ;;
    esac
    ;;
esac
[ -n "${disk:-}" ] || exit 0
[ -b "$disk" ] || exit 0

# 2. 判断 rootfs 文件系统类型
# 注意: mount 输出为 "设备 on 挂载点 type 文件系统", 挂载点在 $3 (不能用 $2, 那是 "on")
root_fs=$(mount | awk '$3=="/" {print $5; exit}')
root_part=$(mount | awk '$3=="/" {print $1; exit}')

case "$root_fs" in
  ext4)
    # ===== 方案2: ext4 rootfs 扩到 8G + p3 数据分区吃满剩余磁盘 =====
    # LEDE 的 ext4 镜像带 reserve_backup_gdb, resize2fs 在线扩容有约 6G 上限,
    # 不能直接吃到 100%。因此: rootfs 扩到 8G(装包足够), 剩余全部给 p3 挂 /opt/docker
    part_num=$(echo "$root_part" | sed 's/.*p\([0-9]*\)$/\1/')
    [ -n "$part_num" ] || exit 0
    part_start=$(parted -s "$disk" unit s print 2>/dev/null | awk -v n="$part_num" '$1==n {print $2}' | tr -d 's')
    [ -n "$part_start" ] || exit 0
    parted -s "$disk" rm "$part_num" 2>/dev/null
    parted -s "$disk" mkpart primary "${part_start}s" 8GiB 2>/dev/null
    blockdev --rereadpt "$disk" 2>/dev/null || partprobe "$disk" 2>/dev/null || partx -u "$root_part" 2>/dev/null || true
    sleep 2
    resize2fs "$root_part" 2>/dev/null || true
    echo "ext4 rootfs resized to 8GiB: $root_part"
    # p3: 占满剩余磁盘(8.2GiB 起, 留 0.2G 余量防对齐问题)
    if [ ! -b "${disk}p3" ]; then
      parted -s "$disk" mkpart primary ext4 8.2GiB 100% 2>/dev/null
      sleep 2
      blockdev --rereadpt "$disk" 2>/dev/null || partprobe "$disk" 2>/dev/null || true
      sleep 2
    fi
    if [ -b "${disk}p3" ]; then
      if ! blkid "${disk}p3" | grep -q 'TYPE="ext4"'; then
        mkfs.ext4 -F -L docker "${disk}p3" 2>/dev/null || true
      fi
      mkdir -p /opt/docker
      uuid=$(blkid -s UUID -o value "${disk}p3" 2>/dev/null || true)
      if [ -n "$uuid" ]; then
        uci -q delete fstab.docker
        uci -q set fstab.docker=mount
        uci -q set fstab.docker.uuid="$uuid"
        uci -q set fstab.docker.target=/opt/docker
        uci -q set fstab.docker.enabled=1
        uci -q commit fstab
      fi
      mount /opt/docker 2>/dev/null || mount -t ext4 "${disk}p3" /opt/docker 2>/dev/null || true
      if uci -q get dockerd.globals >/dev/null 2>&1; then
        uci -q set dockerd.globals.data_root='/opt/docker'
        uci -q commit dockerd
      fi
    fi
    ;;
  squashfs)
    # ===== 方案3: squashfs - 创建 p3 数据分区给 docker =====
    if [ ! -b "${disk}p3" ]; then
      parted -s "$disk" mkpart primary ext4 4.2GiB 100% 2>/dev/null || exit 0
      sleep 2
      blockdev --rereadpt "$disk" 2>/dev/null || partprobe "$disk" 2>/dev/null || true
      sleep 2
    fi
    if [ -b "${disk}p3" ]; then
      if ! blkid "${disk}p3" | grep -q 'TYPE="ext4"'; then
        mkfs.ext4 -F -L docker "${disk}p3" 2>/dev/null || exit 0
      fi
      mkdir -p /opt/docker
      uuid=$(blkid -s UUID -o value "${disk}p3" 2>/dev/null || true)
      if [ -n "$uuid" ]; then
        uci -q delete fstab.docker
        uci -q set fstab.docker=mount
        uci -q set fstab.docker.uuid="$uuid"
        uci -q set fstab.docker.target=/opt/docker
        uci -q set fstab.docker.enabled=1
        uci -q commit fstab
      fi
      mount /opt/docker 2>/dev/null || mount -t ext4 "${disk}p3" /opt/docker 2>/dev/null || true
      if uci -q get dockerd.globals >/dev/null 2>&1; then
        uci -q set dockerd.globals.data_root='/opt/docker'
        uci -q commit dockerd
      fi
    fi
    ;;
  *)
    exit 0
    ;;
esac

# 3. swap 512MB（ext4 放 /var/swapfile，squashfs 放 /opt/docker/swapfile）
if [ "$root_fs" = "ext4" ]; then
  SWAP_FILE=/var/swapfile
else
  SWAP_FILE=/opt/docker/swapfile
fi
if [ ! -f "$SWAP_FILE" ]; then
  mkdir -p "$(dirname "$SWAP_FILE")"
  fallocate -l 512M "$SWAP_FILE" 2>/dev/null || dd if=/dev/zero of="$SWAP_FILE" bs=1M count=512 2>/dev/null
  chmod 600 "$SWAP_FILE"
  mkswap "$SWAP_FILE" 2>/dev/null
fi
if [ -f "$SWAP_FILE" ]; then
  uci -q delete fstab.swap
  uci -q set fstab.swap=swap
  uci -q set fstab.swap.device="$SWAP_FILE"
  uci -q set fstab.swap.enabled=1
  uci -q commit fstab
  swapon "$SWAP_FILE" 2>/dev/null || true
fi

exit 0
