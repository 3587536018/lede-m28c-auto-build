#!/bin/sh
# Each fresh installation resets the system disk's trailing data partition.
# Old /opt data is intentionally discarded; ordinary boots retain new data.
# A durable checkpoint prevents formatting again after mount/config failure.
# Never create swap, format another disk, or format a mounted partition.
# A nonzero exit keeps this uci-defaults script available for the next boot.

set -u
STATE_FILE=/etc/m28c-opt-initialized

fail() {
  echo "99-expand-data: $*" >&2
  logger -t m28c-opt-init "$*" 2>/dev/null || true
  return 1
}

canonical_device() {
  readlink -f "$1" 2>/dev/null
}

partition_disk() {
  local name path
  name=${1##*/}
  [ -f "/sys/class/block/$name/partition" ] || return 1
  path=$(readlink -f "/sys/class/block/$name") || return 1
  printf '/dev/%s\n' "$(basename "$(dirname "$path")")"
}

# mountinfo identifies the real device even when /rom is mounted as /dev/root
# and / is an overlay over a loop-backed squashfs root partition.
mounted_partition() {
  local info id fstype root name
  info=$(awk -v target="$1" '
    $5 == target {
      count++; id=$3; root=$4
      for (i=7; i<=NF; i++) if ($i == "-") { fs=$(i+1); break }
    }
    END { if (count == 1) print id, fs, root; else if (count > 1) print "ambiguous unknown unknown" }
  ' /proc/self/mountinfo) || return 1
  [ -n "$info" ] || return 1
  read -r id fstype root <<EOF
$info
EOF
  name=$(readlink -f "/sys/dev/block/$id" 2>/dev/null) || name=unknown
  printf '/dev/%s %s %s\n' "${name##*/}" "$fstype" "$root"
}

find_boot_partition() {
  local target info candidate token
  for target in /rom /; do
    info=$(mounted_partition "$target") || continue
    candidate=${info%% *}
    if partition_disk "$candidate" >/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  candidate=$(canonical_device /dev/root) || candidate=
  if [ -n "$candidate" ] && partition_disk "$candidate" >/dev/null; then
    printf '%s\n' "$candidate"
    return 0
  fi
  for token in $(cat /proc/cmdline); do
    case "$token" in
      root=/dev/*) candidate=$(canonical_device "${token#root=}") || candidate= ;;
      root=PARTUUID=*|root=UUID=*) candidate=$(blkid -t "${token#root=}" -o device 2>/dev/null) || candidate= ;;
      *) continue ;;
    esac
    if [ -n "$candidate" ] && partition_disk "$candidate" >/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

filesystem_type() {
  blkid -s TYPE -o value "$1" 2>/dev/null
}

find_labeled_partition() {
  local entry candidate label found=
  for entry in /sys/class/block/*; do
    [ -f "$entry/partition" ] || continue
    candidate="/dev/${entry##*/}"
    [ "$(partition_disk "$candidate")" = "$DISK" ] || continue
    label=$(blkid -s LABEL -o value "$candidate" 2>/dev/null) || label=
    case "$label" in
      opt|optdata)
        [ "$(cat "$entry/partition")" -gt "$(cat "/sys/class/block/${BOOT_PARTITION##*/}/partition")" ] || return 1
        [ -z "$found" ] || return 1
        found=$candidate
        ;;
    esac
  done
  printf '%s\n' "$found"
}

# Output the next partition number, start/end logical sectors and sector size.
# Require a simple, contiguous partition table and at least 768 MiB after the
# last existing partition. Holes, extended partitions and unknown tables stop.
partition_plan() {
  local table
  table=$(parted -m -s "$DISK" unit s print free 2>/dev/null) || return 1
  printf '%s\n' "$table" | awk -F: '
    NR == 2 {
      sector=$4+0; table=$6
      if ((sector != 512 && sector != 4096) || (table != "msdos" && table != "gpt")) bad=1
    }
    $2 ~ /^[0-9]+s$/ && $3 ~ /^[0-9]+s$/ {
      start=$2+0; end=$3+0; kind=$5; sub(/;$/, "", kind)
      if (kind == "free") {
        if (end > free_end) { free_start=start; free_end=end }
      } else if ($1 ~ /^[0-9]+$/) {
        count++; if ($1+0 != count || start <= last_end || end < start) bad=1
        if ($1+0 > number) number=$1+0
        if (end > last_end) last_end=end
        if (kind == "extended") bad=1
      } else bad=1
    }
    END {
      if (bad || !sector || count != 2 || number != 2) exit 1
      align=1048576/sector
      start=int((free_start+align-1)/align)*align
      if (free_start <= last_end || (free_end-start+1)*sector < 805306368) exit 1
      printf "%d %.0f %.0f %d\n", number+1, start, free_end, sector
    }
  '
}

create_data_partition() {
  local plan number start end sector part prefix tries actual_start actual_size boot_start boot_size
  command -v parted >/dev/null 2>&1 || { fail "parted is missing"; return 1; }
  plan=$(partition_plan) || { fail "cannot confirm sufficient trailing free space; existing partitions preserved"; return 1; }
  read -r number start end sector <<EOF
$plan
EOF
  boot_start=$(cat "/sys/class/block/${BOOT_PARTITION##*/}/start") || return 1
  boot_size=$(cat "/sys/class/block/${BOOT_PARTITION##*/}/size") || return 1
  case "$boot_start:$boot_size" in *[!0-9:]*|:*) return 1 ;; esac
  [ "$number" = 3 ] && [ "$((start * sector / 512))" -eq "$(((boot_start + boot_size + 2047) / 2048 * 2048))" ] || {
    fail "new partition plan is not immediately after the image root"; return 1
  }
  case "$DISK" in *[0-9]) prefix="${DISK}p" ;; *) prefix=$DISK ;; esac
  part="${prefix}${number}"
  [ ! -e "$part" ] || { fail "$part already exists; refusing to format it"; return 1; }
  parted -s -a optimal "$DISK" unit s mkpart primary ext4 "${start}s" "${end}s" >&2 || {
    fail "partition creation failed; retry after inspecting the partition table"
    return 1
  }
  if command -v partprobe >/dev/null 2>&1; then partprobe "$DISK" >&2 || true; fi
  if command -v blockdev >/dev/null 2>&1; then blockdev --rereadpt "$DISK" >&2 || true; fi
  tries=0
  while [ ! -b "$part" ] && [ "$tries" -lt 5 ]; do
    sleep 1
    tries=$((tries + 1))
  done
  [ -b "$part" ] || { fail "$part is not available; existing partitions preserved"; return 1; }
  actual_start=$(cat "/sys/class/block/${part##*/}/start") || return 1
  actual_size=$(cat "/sys/class/block/${part##*/}/size") || return 1
  [ "$actual_start" -eq "$((start * sector / 512))" ] &&
    [ "$actual_size" -eq "$(((end - start + 1) * sector / 512))" ] || {
    fail "$part geometry differs from the new partition plan; refusing to format"
    return 1
  }
  printf '%s\n' "$part"
}

# Accept only the single trailing partition immediately after this image's
# root partition. Both kernel/sysfs and the on-disk table must agree. This also
# permits a pre-existing exFAT p3, but never a labelled kernel or foreign disk.
verify_data_partition() {
  local name boot_name number boot_number boot_start boot_size table
  name=${PART##*/}; boot_name=${BOOT_PARTITION##*/}
  [ "$PART" != "$BOOT_PARTITION" ] && [ -b "$PART" ] &&
    [ "$(partition_disk "$PART")" = "$DISK" ] || return 1
  number=$(cat "/sys/class/block/$name/partition") || return 1
  boot_number=$(cat "/sys/class/block/$boot_name/partition") || return 1
  DATA_START=$(cat "/sys/class/block/$name/start") || return 1
  DATA_SIZE=$(cat "/sys/class/block/$name/size") || return 1
  boot_start=$(cat "/sys/class/block/$boot_name/start") || return 1
  boot_size=$(cat "/sys/class/block/$boot_name/size") || return 1
  case "$number:$boot_number:$DATA_START:$DATA_SIZE:$boot_start:$boot_size" in
    *[!0-9:]*) return 1 ;;
  esac
  # The pinned M28C image has kernel p1 and root p2. Fail closed on a new layout.
  [ "$boot_number" = 2 ] && [ "$number" = 3 ] &&
    [ "$DATA_START" -eq "$(((boot_start + boot_size + 2047) / 2048 * 2048))" ] &&
    [ "$DATA_SIZE" -ge 1572864 ] || return 1
  table=$(parted -m -s "$DISK" unit s print 2>/dev/null) || return 1
  printf '%s\n' "$table" | awk -F: -v ds="$DATA_START" -v dz="$DATA_SIZE" \
    -v bs="$boot_start" -v bz="$boot_size" '
    NR == 2 {
      sector=$4+0; total=$2+0
      if ((sector != 512 && sector != 4096) || ($6 != "msdos" && $6 != "gpt")) bad=1
    }
    NR > 2 && NF {
      if ($1 !~ /^[123]$/ || $2 !~ /^[0-9]+s$/ || $3 !~ /^[0-9]+s$/) { bad=1; next }
      n=$1+0; start=($2+0)*sector/512; size=(($3+0)-($2+0)+1)*sector/512
      if (n != ++count || start < last_end || size <= 0 || $5 == "extended") bad=1
      last_end=start+size
      if (n == 2 && (start != bs || size != bz)) bad=1
      if (n == 3 && (start != ds || size != dz)) bad=1
    }
    END { if (bad || count != 3 || last_end > total*sector/512) exit 1 }
  '
}

storage_state_load() {
  local version phase boot part start size uuid extra line
  STATE_PHASE=none; STATE_UUID=
  [ ! -L "$STATE_FILE" ] || return 1
  [ -e "$STATE_FILE" ] || return 0
  [ -f "$STATE_FILE" ] && [ "$(wc -l < "$STATE_FILE")" -eq 1 ] || return 1
  line=$(cat "$STATE_FILE") || return 1
  IFS='|' read -r version phase boot part start size uuid extra <<EOF
$line
EOF
  [ "$version" = m28c-opt-v1 ] && [ "$boot" = "$BOOT_PARTITION" ] &&
    [ "$part" = "$PART" ] && [ "$start" = "$DATA_START" ] &&
    [ "$size" = "$DATA_SIZE" ] && [ -z "$extra" ] || return 1
  [ "$line" = "$version|$phase|$boot|$part|$start|$size|$uuid" ] || return 1
  case "$phase:$uuid" in
    pending:none) ;;
    prepared:*) case "$uuid" in ''|*[!a-fA-F0-9-]*) return 1 ;; esac ;;
    *) return 1 ;;
  esac
  STATE_PHASE=$phase; STATE_UUID=$uuid
}

storage_state_store() {
  local temporary
  [ ! -L "$STATE_FILE" ] || return 1
  temporary=$(mktemp "${STATE_FILE}.XXXXXX") || return 1
  if ! chmod 600 "$temporary" ||
    ! printf 'm28c-opt-v1|%s|%s|%s|%s|%s|%s\n' "$1" "$BOOT_PARTITION" "$PART" "$DATA_START" "$DATA_SIZE" "$2" > "$temporary" ||
    ! mv -f "$temporary" "$STATE_FILE"; then
    rm -f "$temporary"
    return 1
  fi
  sync
}

# A normal unmount is allowed only for this exact whole partition at /opt.
# Any other mount, holder, active swap or storage daemon prevents the reset.
verify_reset_idle() {
  local id info entry backing swapdev swaptype rest mounts
  if pidof dockerd containerd >/dev/null 2>&1; then
    fail "Docker/containerd is running; refusing to reset its storage"; return 1
  fi
  id=$(cat "/sys/class/block/${PART##*/}/dev") || return 1
  for entry in /sys/class/block/"${PART##*/}"/holders/*; do
    [ ! -e "$entry" ] && [ ! -L "$entry" ] || { fail "$PART has active holders"; return 1; }
  done
  # Loop devices backed directly by this block partition need not appear in
  # its holders directory (the normal root-overlay loop is backed by p2).
  for entry in /sys/class/block/loop*/loop/backing_file; do
    [ -f "$entry" ] || continue
    backing=$(cat "$entry") || return 1
    [ "$(canonical_device "$backing")" != "$PART" ] || {
      fail "$PART backs an active loop device"; return 1
    }
  done
  # Entries beneath /opt include bind mounts from entirely different devices.
  awk '$5 ~ /^\/opt\// { bad=1 } END { exit bad }' /proc/self/mountinfo || {
    fail "/opt has child mounts"; return 1
  }
  while read -r swapdev swaptype rest; do
    [ "$swapdev" != Filename ] || continue
    case "$swapdev" in /opt/*) fail "active swap under /opt"; return 1 ;; esac
    [ "$(canonical_device "$swapdev")" != "$PART" ] || {
      fail "$PART is active swap"; return 1
    }
  done < /proc/swaps
  mounts=$(awk -v id="$id" '$3 == id { print $5 }' /proc/self/mountinfo) || return 1
  if info=$(mounted_partition /opt); then
    [ "$mounts" = /opt ] && [ "$info" = "$PART $(filesystem_type "$PART") /" ] || {
      fail "/opt or the candidate partition has another mount"; return 1
    }
    umount /opt || { fail "/opt is busy; refusing reset"; return 1; }
  fi
  awk -v id="$id" '$3 == id || $5 == "/opt" || $5 ~ /^\/opt\// { bad=1 } END { exit bad }' /proc/self/mountinfo || {
    fail "$PART remains mounted"; return 1
  }
}

prepare_data_partition() {
  local uuid
  verify_data_partition || { fail "unsafe or unexpected system data partition"; return 1; }
  storage_state_load || { fail "invalid /opt initialization checkpoint; refusing reset"; return 1; }
  case "$STATE_PHASE" in
    prepared)
      uuid=$(blkid -s UUID -o value "$PART" 2>/dev/null) || return 1
      [ "$(filesystem_type "$PART")" = ext4 ] && [ "$uuid" = "$STATE_UUID" ] || {
        fail "prepared /opt identity changed; refusing reset"; return 1
      }
      return 0 ;;
    pending) fail "interrupted /opt format requires inspection; refusing repeat format"; return 1 ;;
  esac
  verify_reset_idle || return 1
  storage_state_store pending none || { fail "cannot persist pre-format checkpoint"; return 1; }
  mkfs.ext4 -F -L optdata "$PART" >&2 || { fail "format failed; checkpoint retained for inspection"; return 1; }
  sync || return 1
  uuid=$(blkid -s UUID -o value "$PART" 2>/dev/null) || return 1
  case "$uuid" in ''|*[!a-fA-F0-9-]*) fail "new ext4 UUID is invalid"; return 1 ;; esac
  [ "$(filesystem_type "$PART")" = ext4 ] || return 1
  storage_state_store prepared "$uuid" || { fail "cannot persist completed format checkpoint"; return 1; }
}

verify_opt_mount() {
  local info actual fstype root target system_mount
  info=$(mounted_partition /opt) || return 1
  read -r actual fstype root <<EOF
$info
EOF
  [ "$actual" = "$PART" ] && [ "$fstype" = ext4 ] && [ "$root" = / ] &&
    [ "$actual" != "$BOOT_PARTITION" ] && partition_disk "$actual" >/dev/null || return 1
  for target in / /rom /overlay; do
    system_mount=$(mounted_partition "$target") || continue
    [ "${system_mount%% *}" != "$actual" ] || return 1
  done
}

configure_storage() {
  local uuid
  verify_opt_mount || { fail "/opt is not the expected ext4 data partition"; return 1; }
  uuid=$(blkid -s UUID -o value "$PART" 2>/dev/null) || uuid=
  [ -n "$uuid" ] || { fail "$PART has no filesystem UUID"; return 1; }
  uci -q delete fstab.opt || true
  uci -q set fstab.opt=mount &&
    uci -q set "fstab.opt.uuid=$uuid" &&
    uci -q set fstab.opt.target=/opt &&
    uci -q set fstab.opt.fstype=ext4 &&
    uci -q set fstab.opt.enabled=1 &&
    uci -q commit fstab || { fail "saving /opt mount configuration failed"; return 1; }
  if uci -q get dockerd.globals >/dev/null 2>&1; then
    [ ! -L /opt/docker ] || { fail "/opt/docker is a symlink; inspect it manually"; return 1; }
    mkdir -p /opt/docker &&
      uci -q set dockerd.globals.data_root=/opt/docker &&
      uci -q commit dockerd || { fail "saving Docker storage configuration failed"; return 1; }
  fi
}

# Existing overlay contents no longer veto the new mount. They are never used
# as Docker storage. Do not recursively delete an unverified overlay directory.
verify_unmounted_opt() {
  [ ! -L /opt ] || { fail "/opt is a symlink"; return 1; }
  [ ! -e /opt ] || [ -d /opt ] || { fail "/opt is not a directory"; return 1; }
}

configure_no_swap() {
  local section
  # Remove only our historical swap entry, never unrelated user entries.
  if [ "$(uci -q get fstab.swap.device)" = /opt/swapfile ]; then
    uci -q delete fstab.swap || return 1
  fi
  section=$(uci -q show fstab | sed -n 's/^fstab\.\([^=]*\)=global$/\1/p') || return 1
  [ -n "$section" ] || { fail "fstab global configuration is missing"; return 1; }
  for section in $section; do
    uci -q set "fstab.$section.auto_swap=0" &&
      uci -q set "fstab.$section.anon_swap=0" || return 1
  done
  uci -q commit fstab
}

initialize_storage() {
  local prefix info
  verify_unmounted_opt || return 1
  BOOT_PARTITION=$(find_boot_partition) || { fail "cannot identify the boot partition"; return 1; }
  DISK=$(partition_disk "$BOOT_PARTITION") || return 1
  [ -b "$DISK" ] || { fail "$DISK is not a block device"; return 1; }
  [ "$(cat "/sys/class/block/${BOOT_PARTITION##*/}/partition")" = 2 ] || {
    fail "unexpected root partition; refusing partition changes"; return 1
  }
  PART=$(find_labeled_partition) || { fail "ambiguous or unsafe opt/optdata labels"; return 1; }
  if [ -z "$PART" ]; then
    case "$DISK" in *[0-9]) prefix="${DISK}p" ;; *) prefix=$DISK ;; esac
    PART="${prefix}3"
    if [ ! -e "$PART" ]; then
      # A checkpoint without its partition is not a new install.
      [ ! -e "$STATE_FILE" ] && [ ! -L "$STATE_FILE" ] || {
        fail "initialized partition disappeared; refusing recreation"; return 1
      }
      PART=$(create_data_partition) || return 1
    fi
  fi
  prepare_data_partition || return 1
  if info=$(mounted_partition /opt); then
    verify_opt_mount || { fail "existing /opt is not the prepared data partition"; return 1; }
  else
    mkdir -p /opt || return 1
    mount -t ext4 "$PART" /opt || { fail "mount failed; prepared checkpoint retained"; return 1; }
  fi
  verify_opt_mount && configure_no_swap && configure_storage || return 1
  echo "99-expand-data: initialized $PART at /opt; Docker storage ready; no swap"
}

main() {
  local result
  mkdir -p /var/lock || return 1
  mkdir /var/lock/m28c-opt-init 2>/dev/null || { fail "storage initialization already locked"; return 1; }
  initialize_storage "$@"
  result=$?
  rmdir /var/lock/m28c-opt-init || return 1
  return "$result"
}

main "$@"
