#!/bin/sh
# Public M28C defaults. Never import credentials, modem identities or subscriptions.
# /etc/config/m28c is preserved by sysupgrade with other UCI configuration.
[ "$(uci -q get m28c.system.initialized)" = '1' ] && exit 0

. /lib/functions.sh

uci -q batch <<'EOF'
set luci.main.lang='zh_cn'
set luci.main.mediaurlbase='/luci-static/argon'
set system.@system[0].hostname='M28C'
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'
EOF

if uci -q get argon.@global[0] >/dev/null; then
    uci set argon.@global[0].primary='#0e7974'
    uci set argon.@global[0].dark_primary='#35b9ad'
fi

# The owner enables Wi-Fi after choosing their own credentials. Preserve keys
# already present when upgrading an existing installation.
configure_wifi() {
    local section="$1" key
    config_get key "$section" key
    [ -n "$key" ] && return 0
    uci set "wireless.$section.ssid=M28C"
    uci set "wireless.$section.encryption=sae-mixed"
    uci set "wireless.$section.disabled=1"
}
if [ -f /etc/config/wireless ]; then
    config_load wireless
    config_foreach configure_wifi wifi-iface
fi

if [ -f /etc/config/cpufreq ]; then
    uci -q batch <<'EOF'
set cpufreq.global=settings
set cpufreq.global.set='1'
set cpufreq.cpufreq=settings
set cpufreq.cpufreq.governor0='schedutil'
set cpufreq.cpufreq.minfreq0='1200000'
set cpufreq.cpufreq.maxfreq0='2016000'
EOF
fi

# QModem discovers the modem and USB path. No per-device SIM/APN/AT-port data.
if [ -f /etc/config/qmodem ]; then
    uci -q batch <<'EOF'
set qmodem.main=main
set qmodem.main.enable_dial='1'
set qmodem.main.enable_usb_scan='1'
set qmodem.main.enable_pcie_scan='1'
set qmodem.main.start_delay='3'
EOF
fi
if [ -f /etc/config/turboacc ]; then
    uci -q batch <<'EOF'
set turboacc.global=turboacc
set turboacc.global.set='1'
set turboacc.config=turboacc
set turboacc.config.tcpcca='bbr'
set turboacc.config.fastpath='flow_offloading'
set turboacc.config.fastpath_fo_hw='0'
set turboacc.config.fullcone='1'
set firewall.@defaults[0].fullcone='1'
EOF
fi

# Enable these services from LuCI after supplying the owner's configuration.
uci -q set openclash.config.enable='0'
uci -q set upnpd.config.enabled='0'
uci -q set vsftpd.global.disabled='1'
for service in openclash vsftpd samba4 ddns ddns-go; do
    [ ! -x "/etc/init.d/$service" ] || "/etc/init.d/$service" disable
done

# Set the initial root password in LuCI over wired LAN. OpenSSH accepts a root
# password after setup, but never an empty password. Do not modify /etc/shadow.
if [ -f /etc/ssh/sshd_config ]; then
    ssh_config=$(mktemp) || exit 1
    cat > "$ssh_config" <<'EOF'
# M28C global defaults (before any preserved Match blocks)
PermitRootLogin yes
PasswordAuthentication yes
PermitEmptyPasswords no
EOF
    cat /etc/ssh/sshd_config >> "$ssh_config"
    cat "$ssh_config" > /etc/ssh/sshd_config || exit 1
    rm -f "$ssh_config"
    /etc/init.d/dropbear disable 2>/dev/null || true
    /etc/init.d/sshd enable || exit 1
fi

uci set m28c.system=system
uci set m28c.system.initialized='1'
uci commit || exit 1
exit 0
